# Copia este archivo a .env y rellena tus valores:  cp .env.example .env
# docker compose lo lee automáticamente; en Dokploy define estas variables
# en la sección Environment de la aplicación.

# --- Obligatoria -------------------------------------------------------------

# Clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# --- Opcionales --------------------------------------------------------------

# Modelo de la Responses API
OPENAI_MODEL=gpt-5

# Contraseña del panel web (HTTP Basic). Muy recomendable si el panel
# es accesible desde internet. Vacía = sin autenticación.
WEB_PASSWORD=

# Avisos por Telegram. Crea un bot con @BotFather para obtener el token;
# tu chat id aparece en https://api.telegram.org/bot<TOKEN>/getUpdates
# tras escribirle un mensaje al bot. Vacías = avisos solo en el panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Límite de gasto: máximo de llamadas a la API al día entre todas las
# búsquedas. 0 = sin límite.  (Antes se llamaba MAX_EJECUCIONES_DIA; el
# nombre antiguo se sigue leyendo si el nuevo no está definido.)
MAX_RUNS_PER_DAY=24

# Intentos por búsqueda ante errores transitorios de OpenAI (500/503, 429,
# cortes de red), con espera creciente entre ellos. 1 = sin reintentos.
# (Antes REINTENTOS_API, que también se sigue leyendo.)
API_RETRIES=3
